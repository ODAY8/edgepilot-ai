# Copy to .env and adjust as needed. The app reads these via os.getenv
# with sensible local-dev defaults, so it runs fine without a .env file
# for everything except Groq reasoning (see below). To actually load this
# file, start uvicorn with `--env-file .env` (python-dotenv comes along
# with uvicorn[standard], which is what makes that flag work), or export
# the variables yourself before running uvicorn.

# Comma-separated list of origins allowed to call this API (CORS).
FRONTEND_ORIGIN=http://localhost:5173

# Google API key for REAL vision analysis (get a free one at
# https://aistudio.google.com/apikey). Required for /api/analyze to work --
# unlike Groq reasoning below, there is no fallback for vision. If this is
# unset, /api/analyze returns 503 rather than fabricating a detection.
GEMINI_API_KEY=

# Gemini model id used for vision analysis. This is a "-latest" alias that
# auto-tracks Google's current fastest model for this tier -- deliberately,
# since dated model ids on Gemini get deprecated (gemini-2.0-flash and later
# gemini-2.5-flash-lite were both retired during this project's development).
# Pin to a specific dated model (e.g. gemini-3.5-flash-lite) instead if you
# want fully reproducible behavior. If this 404s, list what's currently
# available on your account:
#   python -c "from google import genai; import os; [print(m.name) for m in genai.Client(api_key=os.environ['GEMINI_API_KEY']).models.list()]"
GEMINI_MODEL=gemini-flash-lite-latest

# Path to the SQLite database file.
DATABASE_PATH=./edgepilot.db

# Python logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Groq API key for LLM-backed reasoning (get one at https://console.groq.com/keys).
# If unset, the /api/analyze pipeline falls back to the rule-based template
# reasoning from services/reasoning.py + services/recommendations.py
# automatically -- nothing breaks if this is missing or Groq is down.
GROQ_API_KEY=

# Groq model id used for reasoning. Model availability on Groq changes
# over time -- if this 404s with "model_not_found", run this to see
# what's currently available on your account:
#   python -c "from groq import Groq; import os; [print(m.id) for m in Groq(api_key=os.environ['GROQ_API_KEY']).models.list().data]"
GROQ_MODEL=openai/gpt-oss-120b

# How long (seconds) a given event type on a given camera stays "already
# logged" before /api/analyze-frame will create another incident for it.
# Prevents a single ongoing event from spamming a new incident (and a new
# Groq call) every 3-5 seconds while the live browser camera keeps polling.
LIVE_EVENT_COOLDOWN_SECONDS=60
